# .env.example — compreface-api. Salin ke .env lalu isi nilai yang ditandai WAJIB. (.env tidak di-commit)
# Nama variabel sama dengan ConfigMap/Secret di k8s/base. JANGAN isi nilai asli di file ini.
# JDBC URL
POSTGRES_URL=jdbc:postgresql://compreface-postgres-db:5432/frs
# URL core (ClusterIP)
PYTHON_URL=http://compreface-core:3000
SPRING_PROFILES_ACTIVE=dev
API_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Jakarta
SAVE_IMAGES_TO_DB=true
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB
# ms, ke core
CONNECTION_TIMEOUT=10000
# ms, ke core
READ_TIMEOUT=60000
# retry ke core
MAX_ATTEMPTS=1
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
LOGGING_LEVEL_COM_EXADEL=INFO
TZ=Asia/Jakarta
# WAJIB — Secret compreface-postgres-credentials
POSTGRES_USER=
# WAJIB — Secret compreface-postgres-credentials
POSTGRES_PASSWORD=
